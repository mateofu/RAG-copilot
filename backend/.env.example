RAG_COPILOT_APP_NAME=RAG Copilot API
RAG_COPILOT_ENVIRONMENT=development
RAG_COPILOT_DEBUG=false
RAG_COPILOT_DATABASE_URL=postgresql+psycopg://rag:rag@postgres:5432/rag_copilot
RAG_COPILOT_REDIS_URL=redis://redis:6379/0
RAG_COPILOT_CELERY_BROKER_URL=redis://redis:6379/1
RAG_COPILOT_CELERY_RESULT_BACKEND=redis://redis:6379/2
RAG_COPILOT_READINESS_TIMEOUT_SECONDS=2
